# Copiar a .env (ignorado por git). Sin valores reales en este archivo.

# Claude
CLAUDE_PROVIDER=cli      # cli (claude -p, suscripción) | anthropic (API key)
CLAUDE_MODEL=            # por defecto: haiku (cli) / claude-haiku-5-5 (anthropic)
CLAUDE_TIMEOUT_S=        # por defecto: 15 (cli) / 10 (anthropic)
CLAUDE_CLI=              # ruta a claude.exe si no está en el PATH
ANTHROPIC_API_KEY=       # solo con CLAUDE_PROVIDER=anthropic

# YOLO
YOLO_WEIGHTS=vision/models/best.pt   # pesos entrenados en Colab (ignorados por git); si no existen, YOLOE con "plate"/"bowl"
YOLO_DEVICE=cpu                      # cpu o 0 (GPU)

# Telegram (solo envío)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=   # grupo "Mozos"

# Modo demo: cadencias y umbrales cortos (ver docs/context/04 y 05); --demo le gana
DEMO_MODE=true

# Umbrales de avisos en segundos (opcionales; --t1/--t2/--reminder les ganan). Ver docs/context/05
ALERT_T1=
ALERT_T2=
ALERT_REMINDER=

# Segundos en por_terminar para pasar a vacio (opcional; por defecto 6 min, en demo 6 lecturas)
FINISHED_AFTER=
