# Copiar a .env (ignorado por git). Sin valores reales en este archivo.

# Claude
CLAUDE_PROVIDER=cli      # cli (claude -p, suscripción) | anthropic (API key) | openai (Decisions API)
CLAUDE_MODEL=            # por defecto: haiku (cli) / claude-haiku-5-5 (anthropic)
OPENAI_MODEL=            # por defecto: gpt-6-luna (solo con CLAUDE_PROVIDER=openai)
OPENAI_TIMEOUT_S=        # por defecto: 14 (solo con CLAUDE_PROVIDER=openai)
CLAUDE_TIMEOUT_S=        # por defecto: 15 (cli) / 10 (anthropic)
CLAUDE_CLI=              # ruta a claude.exe si no está en el PATH
ANTHROPIC_API_KEY=       # solo con CLAUDE_PROVIDER=anthropic
OPENAI_API_KEY=          # solo con CLAUDE_PROVIDER=openai
CLAUDE_PROMPT_FILE=      # otro prompt para Claude (por defecto vision/prompts/claude.txt)
SMOOTH_READINGS=         # lecturas para pasar al estado vecino (por defecto 2)
SMOOTH_HARD_READINGS=    # lecturas para un salto o retroceso (por defecto 3)
SMOOTH_MIN_CONFIDENCE=   # confianza mínima de un salto (por defecto 0.8; OpenAI da menos)
OPENAI_PROMPT_FILE=      # otro prompt para la Decisions API (por defecto vision/prompts/openai.json)

# YOLO
YOLO_WEIGHTS=vision/models/best.pt   # pesos entrenados en Colab (ignorados por git); si no existen, YOLOE con "plate"/"bowl"
YOLO_DEVICE=cpu                      # cpu o 0 (GPU)

# Telegram (solo envío)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=   # grupo "Mozos"

# Modo demo: cadencias y umbrales cortos (ver docs/context/04 y 05); --demo le gana
DEMO_MODE=true

# Docker (solo compose.yaml). Sin comentarios en la misma línea: compose los lee como valor.
# SERVIO_SOURCE: rtsp://usuario:clave@ip/stream, o 0 para una cámara USB. Si la clave tiene $,
#   poné el valor entre comillas simples ('rtsp://...'): si no, compose lo toma como variable.
# SERVIO_CLASSIFIER: por defecto hybrid
# SERVIO_CLAUDE_PROVIDER: por defecto anthropic (cli no anda en el contenedor); le gana a CLAUDE_PROVIDER
# SERVIO_DEMO_MODE: por defecto false (umbrales reales); le gana a DEMO_MODE
SERVIO_SOURCE=
SERVIO_CLASSIFIER=
SERVIO_CLAUDE_PROVIDER=
SERVIO_DEMO_MODE=

# Umbrales de avisos en segundos (opcionales; --t1/--t2/--reminder les ganan). Ver docs/context/05
ALERT_T1=
ALERT_T2=
ALERT_REMINDER=

# Segundos en por_terminar para pasar a vacio (opcional; por defecto 6 min, en demo 6 lecturas)
FINISHED_AFTER=
