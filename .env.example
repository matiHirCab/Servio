# Copiar a .env (ignorado por git). Sin valores reales en este archivo.

# vision/
SERVIO_API_URL=http://localhost:3000
INGEST_TOKEN=
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=
CLAUDE_PROVIDER=bedrock   # bedrock | anthropic
ANTHROPIC_API_KEY=        # respaldo si Bedrock no está disponible
YOLO_WEIGHTS=vision/models/best.pt   # solo si se usa --classifier yolo (ignorado por git)
DEMO_MODE=true            # cadencias cortas (ver docs/context/04-vision.md); --demo le gana

# web/
DATABASE_URL=
INGEST_TOKEN=             # el mismo valor que en vision/
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GROUP_CHAT_ID=   # grupo "Mozos" (scripts de prueba y demo)
NEXT_PUBLIC_USE_FIXTURES=false   # true = el dashboard lee fixtures/api/ (plan B)
DEMO_MODE=true            # umbrales cortos (ver docs/context/05-reglas-alertas.md)
