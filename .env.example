# Copiar a .env (ignorado por git). Sin valores reales en este archivo.

# Claude
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=
CLAUDE_PROVIDER=bedrock   # bedrock | anthropic
ANTHROPIC_API_KEY=        # respaldo si Bedrock no está disponible

# YOLO
YOLO_WEIGHTS=vision/models/best.pt   # pesos entrenados en Colab (ignorados por git)

# Telegram (solo envío)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=   # grupo "Mozos"

# Modo demo: cadencias y umbrales cortos (ver docs/context/04 y 05); --demo le gana
DEMO_MODE=true

# Umbrales de avisos en segundos (opcionales; --t1/--t2/--reminder les ganan). Ver docs/context/05
ALERT_T1=
ALERT_T2=
ALERT_REMINDER=
